# Lamatic API Configuration
LAMATIC_API_KEY=your_lamatic_api_key_here
LAMATIC_ENDPOINT=https://api.lamatic.ai
LAMATIC_PROJECT_ID=migration-tool

# Migration Settings
MAX_FILE_SIZE=10485760
SUPPORTED_FILE_TYPES=.json

# Development Settings
NODE_ENV=development

# Schema validation strict mode (warn-only by default)
LAMATIC_SCHEMA_STRICT=false
